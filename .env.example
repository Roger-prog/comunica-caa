VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Preencha apenas uma opção com a chave pública do projeto.
# A opção PUBLISHABLE_KEY tem preferência quando ambas estão preenchidas.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_TTS_API_URL=/api/tts
# Preencha apenas uma credencial do Supabase para a API de fotos, somente no servidor.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
